# Copy to .env (never commit) or put these in your process manager / host environment.

# Required: server-side Gemini API key. Create it at https://aistudio.google.com/apikey
# and keep it here only. It is never sent to the Android app.
GEMINI_API_KEY=

# Required in production: at least 32 characters. Generate with: openssl rand -hex 32
JARVIS_SESSION_SECRET=

# Optional
PORT=8787
HOST=127.0.0.1
JARVIS_GEMINI_MODEL=gemini-3.8-live
JARVIS_TOKEN_TTL_SECONDS=1800
JARVIS_SESSION_TTL_SECONDS=900
JARVIS_RATE_LIMIT=12
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
