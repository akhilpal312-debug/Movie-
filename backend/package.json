{
  "name": "jarvis-token-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Short-lived Gemini Live token broker for the JARVIS Android assistant. Holds the API key server-side.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
